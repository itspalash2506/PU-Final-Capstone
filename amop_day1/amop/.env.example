# ─── LLM Provider (OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=
# Add all your API keys here (comma-separated). A random one is picked per call.
# Include OPENROUTER_API_KEY value here too so it's part of the rotation pool.
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_ROUTER_MODEL=
OPENROUTER_ROUTER_FALLBACK_MODELS=

# ─── AMOP API Authentication ──────────────────────────────────────────────────
AMOP_API_KEY=

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=
QDRANT_PORT=
QDRANT_COLLECTION=

# ─── SQLite ───────────────────────────────────────────────────────────────────
SQLITE_PATH=

# ─── Embeddings (local sentence-transformers, no API key needed) ──────────────
EMBEDDING_MODEL=
EMBEDDING_DIM=

# ─── Prediction Model ─────────────────────────────────────────────────────────
MODEL_PATH=
BM25_INDEX_PATH=

# ─── App Settings ─────────────────────────────────────────────────────────────
LOG_LEVEL=
APP_ENV=
